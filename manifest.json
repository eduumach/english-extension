{
  "manifest_version": 3,
  "name": "YouTube English Study",
  "version": "0.1.0",
  "description": "Captura as legendas do YouTube e destaca palavras novas vs. conhecidas para estudar ingles.",
  "permissions": ["storage"],
  "host_permissions": ["https://www.youtube.com/*"],
  "action": {
    "default_title": "YouTube English Study",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
